name = "Default"
is_default = true
lifecycle = "default-promotion"

git_resource_rule {
    rules = "refs/heads/main"

    git_dependencies {
        deployment_action_slug = "deploy-yaml-deploy-yaml"
        git_dependency_name = ""
    }
}

rule {
    tag = "sha-[0-9a-f]{7}"
    version_range = ""

    deployment_action_packages {
        package = "KubernetesYaml.DeploymentImage"
        step = "Deploy YAML-Deploy YAML"
    }
}