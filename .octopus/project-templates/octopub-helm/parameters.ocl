parameter "ProjectTemplate.Helm.Git.Url" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Url to the git repository of the Helm chart."
    label = "Chart Repository Url"
}

parameter "ProjectTemplate.Helm.Container.Image" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = "Sets the image to update in the Helm Chart."
    label = "Container Image"
}

parameter "ProjectTemplate.Helm.ValuesFile" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Relative path in the repo that holds the values file."
    label = "Values File Path"
}

parameter "ProjectTemplate.Target.Tag" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "The Target Tag to deploy to."
    label = "Target Tag"
}

parameter "ProjectTemplate.Namespace.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "The namespace to install the helm chart to."
    label = "Namespace"
}