name = "Require Predeploy Gates"
description = "Checks that every deployment to Production or a shared environment (Test) runs the Predeploy Boilerplate process template with its gates in place: Calculate Deployment Mode always runs, and the rollback and AI-assisted review pauses are enabled and not skipped. The step must also be named Predeploy Boilerplate (slug predeploy-boilerplate), because other steps refer to it by name."
violation_action = "warn"
violation_reason = "Deployments must run the `Predeploy Boilerplate` process template, version 2 or later, named `Predeploy Boilerplate`, with its gates enabled and not skipped."

conditions {
    rego = <<-EOT
            package require_predeploy_gates

            # A policy can't read release custom fields, so it can't tell an
            # AI-assisted release apart. It requires the step that can: the
            # Confirm AI-assisted release pause, which reads AIAssisted itself.
            # The pauses are conditional by design, so they only need to be
            # present, enabled, and not skipped. Calculate Deployment Mode
            # feeds their conditions, so it must also be unconditional.

            default result := {
                "allowed": false,
                "reason": "Run the Predeploy Boilerplate process template (version 2 or later). Keep Calculate Deployment Mode, Confirm rollback, and Confirm AI-assisted release enabled, and don't skip them.",
            }

            # Two ways to fail, with different reasons. The default result above
            # covers missing or weakened gates. The second result below covers
            # a boilerplate whose gates are fine but whose step has the wrong
            # name. A default rule can't hold a sprintf, so the naming reason
            # is its own rule, and it can't be true together with the pass.

            gates_in_place if {
                count(mode_steps) > 0
                count(rollback_steps) > 0
                count(ai_review_steps) > 0

                every step in boilerplate_steps {
                    step.Enabled == true
                    not step.Id in input.SkippedSteps
                }

                every step in mode_steps {
                    step.IsConditional == false
                }
            }

            # Other steps refer to the boilerplate by name, such as the
            # rollback expression on Postgres.Review.Policy, which reads
            # Octopus.Action[Predeploy Boilerplate-Calculate Deployment Mode].
            # A different name stops that expression matching, so a rollback
            # stops pausing at the DBA review and nothing reports it. The input
            # has the step slug and no display name, so the slug stands in for
            # the name. Expanded step ids start with the step slug.
            named_correctly if {
                every step in boilerplate_steps {
                    startswith(step.Id, "predeploy-boilerplate-")
                }
            }

            result := {"allowed": true} if {
                gates_in_place
                named_correctly
            }

            result := {
                "allowed": false,
                "reason": sprintf("The Predeploy Boilerplate step has the slug `%s`. Name it `Predeploy Boilerplate`, with the slug `predeploy-boilerplate`. Other steps refer to it by name, such as the rollback expression on Postgres.Review.Policy, so any other name stops a rollback pausing at the DBA review.", [trim_suffix(mode_steps[0].Id, "-calculate-deployment-mode")]),
            } if {
                gates_in_place
                not named_correctly
            }

            boilerplate_steps := [step |
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId == "predeploy-boilerplate"
            ]

            # Expanded step ids end with the template step slug.
            mode_steps := [step |
                some step in boilerplate_steps
                endswith(step.Id, "calculate-deployment-mode")
            ]

            rollback_steps := [step |
                some step in boilerplate_steps
                endswith(step.Id, "confirm-rollback")
            ]

            ai_review_steps := [step |
                some step in boilerplate_steps
                endswith(step.Id, "confirm-ai-assisted-release")
            ]
            EOT
}

scope {
    rego = <<-EOT
            package require_predeploy_gates

            default evaluate := false

            # Deployments to the higher environments: Production, and shared
            # environments such as Test. That's where rollbacks and AI-assisted
            # releases need their pauses. Development stays quiet, so a
            # developer working on a new pipeline isn't warned about the
            # boilerplate on the first deploy. Runbook runs have no deployment
            # mode.
            evaluate if {
                not input.Runbook
                "Meta-Environment/Production" in input.Environment.Tags
            }

            evaluate if {
                not input.Runbook
                "EnvironmentUsage/Shared" in input.Environment.Tags
            }
            EOT
}
