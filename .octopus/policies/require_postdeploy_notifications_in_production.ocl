name = "Require PostDeploy Notifications in Production"
description = "Checks that production deployments are using the correct notification template."
violation_action = "block"
violation_reason = "You must use the `Notifications - PostDeploy` process template when deploying to production."

conditions {
    rego = <<-EOT
            package require_postdeploy_notifications_in_production
            
            default result := {
                "allowed": false,
                "action": "block",
                "reason": "Production deployments and runbook runs must use the Notifications - PostDeploy process template. Add the template, enable it, and do not skip it.",
            }
            
            result := {"allowed": true} if {
                count(process_template_steps) > 0
            
                every step in process_template_steps {
                    step.Enabled == true
                    step.IsConditional == false
                    not step.Id in input.SkippedSteps
                }
            }
            
            process_template_steps := [step |
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId == "notifications-postdeploy"
            ]
            EOT
}

scope {
    rego = <<-EOT
            package require_postdeploy_notifications_in_production
            
            default evaluate := false
            
            evaluate if {
                some tag in input.Environment.Tags
                tag == "Meta-Environment/Production"
            }
            EOT
}