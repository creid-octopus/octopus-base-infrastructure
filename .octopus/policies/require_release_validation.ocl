name = "Require Release Validation"
description = "Check that the Release Validation process template is used"
violation_action = "block"
violation_reason = "A required process template is missing"

conditions {
    rego = <<-EOT
            package require_release_validation
            
            # Default: Deny all deployments
            default result := {"allowed": false}
            
            # Allow: If a specific Process Template is used and not bypassed
            result := {"allowed": true} if {
            	some step in input.Steps
            
            	# Ensure the step is derived from a Process Template
            	step.Source.Type == "Process Template"
            
            	# Target a specific template by its unique slug or ID
            	step.Source.SlugOrId == "release-validation"
            
            	# Verify this specific step hasn't been added to the skipped list
            	not step.Id in input.SkippedSteps
            }
            EOT
}

scope {
    rego = <<-EOT
            package require_release_validation
            
            default evaluate := false
            
            evaluate if {
                    startswith(input.Project.Slug, "kubernetes-")
                    not input.Runbook
            }
            EOT
}