name = "Confirm Latest Predeploy Boilerplate Versioning"
description = "Warns when a deployment runs a Predeploy Boilerplate version older than 2.0.0. Platform Hub doesn't show which projects use which template version, so this policy's evaluations do: every warning names a project that still needs to move its usage to 2.X."
violation_action = "warn"
violation_reason = "This deployment uses a Predeploy Boilerplate version older than 2.0.0. Update the usage's version mask to 2.X and create a new release."

conditions {
    rego = <<-EOT
            package confirm_latest_predeploy_boilerplate_versioning

            # Every step that comes from Predeploy Boilerplate reports the
            # template version the release resolved, such as 1.2.0. A release
            # keeps the versions from when it was created, so a project only
            # passes after it creates a release from a 2.X usage.

            default result := {
                "allowed": false,
                "reason": "Predeploy Boilerplate didn't report a valid semantic version. Check the usage's version mask.",
            }

            result := {"allowed": true} if {
                all_current
            }

            result := {
                "allowed": false,
                "reason": sprintf("Predeploy Boilerplate %v is older than 2.0.0. Update the usage's version mask to 2.X and create a new release.", [concat(", ", old_versions)]),
            } if {
                count(old_versions) > 0
            }

            boilerplate_versions := {step.Source.Version |
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId == "predeploy-boilerplate"
            }

            old_versions := {version |
                some version in boilerplate_versions
                semver.is_valid(version)
                semver.compare(version, "2.0.0") < 0
            }

            all_current if {
                count(boilerplate_versions) > 0
                every version in boilerplate_versions {
                    semver.is_valid(version)
                    semver.compare(version, "2.0.0") >= 0
                }
            }
            EOT
}

scope {
    rego = <<-EOT
            package confirm_latest_predeploy_boilerplate_versioning

            default evaluate := false

            # Deployments that use Predeploy Boilerplate. Runbook runs don't use
            # it. A project without it at all is Require Predeploy Gates' job.
            evaluate if {
                not input.Runbook
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId == "predeploy-boilerplate"
            }
            EOT
}
