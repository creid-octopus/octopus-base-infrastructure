name = "kubectl - Delete Namespace"
description = "`kubectl` script - delete a namespace and everything in it, if it exists. Runs only in the environments you choose. Refuses system namespaces and the protected environment. Use it to remove an ephemeral environment's namespace."

parameter "Kubectl.DeleteNamespace.TargetTag" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Deployment target tag of the cluster that holds the namespace."
    label = "Kubernetes target tag for deployment"
}

parameter "Kubectl.DeleteNamespace.WorkerPool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = "Worker pool that runs this step."
    label = "Worker Pool"
}

parameter "Kubectl.DeleteNamespace.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Namespace to delete. Everything in it is deleted too. Nothing happens if it doesn't exist."
    label = "Namespace Name"
}

parameter "Kubectl.DeleteNamespace.ProtectedEnvironment" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Environment name where this step refuses to run. Leave blank to protect nothing."
    label = "Protected environment"

    value "Production" {}
}

parameter "Kubectl.DeleteNamespace.TimeoutSeconds" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "How long to wait for the namespace and its resources to finish deleting before the step fails."
    label = "Timeout in seconds"

    value "300" {}
}

parameter "Kubectl.DeleteNamespace.RunOnEnvironments" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments where this step runs. It's skipped everywhere else. For ephemeral environments, choose the parent environment."
    label = "Run in environments"
}

step "delete-namespace" {
    name = "Delete Namespace"
    properties = {
        Octopus.Action.TargetRoles = "#{Kubectl.DeleteNamespace.TargetTag}"
    }

    action {
        action_type = "Octopus.KubernetesRunScript"
        environments_variables = ["#{Kubectl.DeleteNamespace.RunOnEnvironments}"]
        notes = "Runs only in the environments chosen in Run in environments. Deletes the namespace and waits until it's gone. Nothing happens if it doesn't exist. Refuses system namespaces and the protected environment."
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/usr/bin/env bash
                set -euo pipefail
                NAMESPACE="$(get_octopusvariable "Kubectl.DeleteNamespace.Name")"
                PROTECTED="$(get_octopusvariable "Kubectl.DeleteNamespace.ProtectedEnvironment")"
                TIMEOUT="$(get_octopusvariable "Kubectl.DeleteNamespace.TimeoutSeconds")"
                ENVIRONMENT_NAME="$(get_octopusvariable "Octopus.Environment.Name")"
                
                if [[ -n "$PROTECTED" && "${ENVIRONMENT_NAME,,}" == "${PROTECTED,,}" ]]; then
                  echo "Refusing to delete namespace '$NAMESPACE': '$ENVIRONMENT_NAME' is the protected environment."
                  exit 1
                fi
                
                case "$NAMESPACE" in
                  "" )
                    echo "Refusing to delete: the namespace name is empty."
                    exit 1 ;;
                  default | kube-system | kube-public | kube-node-lease | octopus-agent-* )
                    echo "Refusing to delete the system namespace '$NAMESPACE'."
                    exit 1 ;;
                esac
                
                if ! kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
                  echo "Namespace '$NAMESPACE' doesn't exist. Nothing to delete."
                  exit 0
                fi
                
                echo "Deleting namespace '$NAMESPACE' and everything in it"
                kubectl delete namespace "$NAMESPACE" --ignore-not-found --wait=true --timeout="${TIMEOUT}s"
                echo "Done: namespace '$NAMESPACE' is gone"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = "#{Kubectl.DeleteNamespace.WorkerPool}"
    }
}