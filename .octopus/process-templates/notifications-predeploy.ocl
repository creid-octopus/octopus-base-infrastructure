name = "Notifications - PreDeploy"
description = "Standardized predeployment notification step(s)."

parameter "Parameters.CustomMessage" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""
}

parameter "Slack.PreDeploy.ProjectLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}>" {}
}

parameter "Slack.PreDeploy.ReleaseLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>" {}
}

parameter "Slack.PreDeploy.DeploymentLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>" {}
}

parameter "Slack.Predeploy.RunEnvs" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = ""
    label = ""
}

step "slack-deployment-starting" {
    name = "Slack - Deployment Starting"

    action {
        action_type = "Octopus.SendSlackMessage"
        environments_variables = ["#{Slack.Predeploy.RunEnvs}"]
        properties = {
            Octopus.Action.Slack.Blocks = <<-EOT
                	[
                		{
                			"type": "section",
                			"text": {
                				"type": "mrkdwn",
                				"text": ":construction: #{Slack.PostDeploy.ProjectLink | JsonEscape} #{Octopus.Release.Number | JsonEscape} to #{Octopus.Environment.Name}\n\n#{if Parameters.CustomMessage | JsonEscape}Custom Message: #{Parameters.CustomMessage | JsonEscape}#{/if}"
                			}
                		},
                		{
                			"type": "divider"
                		},
                		{
                			"type": "actions",
                			"elements": [
                				{
                					"type": "button",
                					"text": {
                						"type": "plain_text",
                						"text": ":mag_right:View Release",
                						"emoji": true
                					},
                					"value": "#{Slack.PostDeploy.ReleaseLink | JsonEscape}",
                					"action_id": "actionId-release"
                				},
                				{
                					"type": "button",
                					"text": {
                						"type": "plain_text",
                						"text": ":microscope:View Deployment",
                						"emoji": true
                					},
                					"value": "#{Slack.PostDeploy.DeploymentLink | JsonEscape}",
                					"action_id": "actionId-deployment"
                				}
                			]
                		}
                	]
                EOT
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                :construction: Deployment starting for  
                 #{Slack.PreDeploy.ProjectLink} to #{Octopus.Environment.Name} 
                
                #{Slack.PreDeploy.ReleaseLink} | #{Slack.PreDeploy.DeploymentLink}
                
                #{if Parameters.CustomMessage}
                Custom: #{Parameters.CustomMessage}
                #{/if}
                EOT
            Octopus.Action.Slack.MessageFormat = "BlockKit"
            Octopus.Action.Slack.Title = "Deployment Starting"
        }
    }
}