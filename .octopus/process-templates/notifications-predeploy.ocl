name = "Notifications - PreDeploy"
description = "Standardized predeployment notification step(s)."

step "slack-deployment-starting" {
    name = "Slack - Deployment Starting"

    action {
        action_type = "Octopus.SendSlackMessage"
        properties = {
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                :construction:Deployment starting for  
                 <#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}> to #{Octopus.Environment.Name} 
                
                <#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}> | <#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|Follow deployment status here>
                EOT
        }
    }
}