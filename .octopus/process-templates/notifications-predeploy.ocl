name = "Notifications - PreDeploy"
description = "Standardized Slack notification for the start of a deployment or a runbook run. One template covers both, the same way Notifications - PostDeploy does."

parameter "Parameters.CustomMessage" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Extra text added to the end of the Slack message. Leave blank for none."
    is_optional = true
    label = "Custom message"
}

parameter "Slack.Predeploy.RunEnvs" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments where the notification is sent. It's skipped everywhere else."
    label = "Run in environments"
}

parameter "Slack.PreDeploy.ProjectLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to the project. The default links to this project in Octopus."
    label = "Project link"

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}>" {}
}

parameter "Slack.PreDeploy.ReleaseLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to what is about to run. The default links to the release for a deployment, or to the runbook snapshot for a runbook run. Used in the plain-text fallback message."
    label = "Release link"

    value "#{if Octopus.RunbookRun.Id}#{if Octopus.RunbookSnapshot.Id}<#{Octopus.Web.ServerUri}#{Octopus.Web.RunbookSnapshotLink}|#{Octopus.RunbookSnapshot.Name}>#{/if}#{else}<#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>#{/if}" {}
}

parameter "Slack.PreDeploy.DeploymentLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to this run. The default links to the deployment, or to the runbook run. Used in the plain-text fallback message."
    label = "Deployment link"

    value "#{if Octopus.RunbookRun.Id}<#{Octopus.Web.ServerUri}#{Octopus.Web.RunbookRunLink}|#{Octopus.RunbookRun.Name}>#{else}<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>#{/if}" {}
}

step "slack-deployment-starting" {
    name = "Slack - Deployment Starting"

    action {
        action_type = "Octopus.SendSlackMessage"
        environments_variables = ["#{Slack.Predeploy.RunEnvs}"]
        notes = "Works for deployments and runbook runs. Octopus.RunbookRun.Id only exists in a runbook run, so each part that differs switches on it. Buttons use url, not value. A button without a url is interactive, and Slack sends the click to the app's interactivity URL, which this app doesn't have."
        properties = {
            Octopus.Action.Slack.Blocks = <<-EOT
                [
                	{
                		"type": "section",
                		"text": {
                			"type": "mrkdwn",
                			"text": ":construction: #{Slack.PreDeploy.ProjectLink | JsonEscape} #{if Octopus.RunbookRun.Id}running *#{Octopus.Runbook.Name | JsonEscape}* #{if Octopus.RunbookSnapshot.Name}(#{Octopus.RunbookSnapshot.Name | JsonEscape}) #{else}#{if Octopus.RunbookRun.Git.BranchName}(#{Octopus.RunbookRun.Git.BranchName | JsonEscape}@#{Octopus.RunbookRun.Git.CommitHash | Substring 7}) #{/if}#{/if}in#{else}#{Octopus.Release.Number | JsonEscape} to#{/if} #{Octopus.Environment.Name | JsonEscape}#{if Octopus.Deployment.Tenant.Name} for #{Octopus.Deployment.Tenant.Name | JsonEscape}#{/if}#{if Parameters.CustomMessage}\n\nCustom Message: #{Parameters.CustomMessage | JsonEscape}#{/if}"
                		}
                	},
                	{ "type": "divider" },
                	{
                		"type": "actions",
                		"elements": [
                			#{if Octopus.RunbookRun.Id}
                				#{if Octopus.RunbookSnapshot.Id}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": ":mag_right: View Snapshot", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.RunbookSnapshotLink | JsonEscape}",
                					"action_id": "actionId-snapshot"
                				},
                				#{/if}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": ":microscope: View Runbook Run", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.RunbookRunLink | JsonEscape}",
                					"action_id": "actionId-runbook-run"
                				}
                			#{else}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": ":mag_right: View Release", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.ReleaseLink | JsonEscape}",
                					"action_id": "actionId-release"
                				},
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": ":microscope: View Deployment", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.DeploymentLink | JsonEscape}",
                					"action_id": "actionId-deployment"
                				}
                			#{/if}
                		]
                	}
                ]
                EOT
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                #{if Octopus.RunbookRun.Id}:construction: Runbook run starting for#{else}:construction: Deployment starting for#{/if}
                #{Slack.PreDeploy.ProjectLink} #{if Octopus.RunbookRun.Id}running #{Octopus.Runbook.Name} in#{else}to#{/if} #{Octopus.Environment.Name}#{if Octopus.Deployment.Tenant.Name} for #{Octopus.Deployment.Tenant.Name}#{/if}

                #{if Slack.PreDeploy.ReleaseLink}#{Slack.PreDeploy.ReleaseLink} | #{/if}#{Slack.PreDeploy.DeploymentLink}

                #{if Parameters.CustomMessage}
                Custom: #{Parameters.CustomMessage}
                #{/if}
                EOT
            Octopus.Action.Slack.MessageFormat = "BlockKit"
            Octopus.Action.Slack.Title = "#{if Octopus.RunbookRun.Id}Runbook Starting#{else}Deployment Starting#{/if}"
        }
    }
}
