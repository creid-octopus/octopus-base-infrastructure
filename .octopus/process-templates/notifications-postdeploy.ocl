name = "Notifications - PostDeploy"
description = "Standardized Slack notification for the end of a deployment or a runbook run. One template covers both, so a Production policy can require it on every run."

parameter "Slack.PostDeploy.ProjectLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to the project. The default links to this project in Octopus."
    is_optional = true
    label = "Project link"

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}>" {}
}

parameter "Slack.PostDeploy.ReleaseLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to what ran. The default links to the release for a deployment, or to the runbook snapshot for a runbook run (blank for a runbook stored in Git, which has no snapshot)."
    is_optional = true
    label = "Release link"

    value "#{if Octopus.RunbookRun.Id}#{if Octopus.RunbookSnapshot.Id}<#{Octopus.Web.ServerUri}#{Octopus.Web.RunbookSnapshotLink}|#{Octopus.RunbookSnapshot.Name}>#{/if}#{else}<#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>#{/if}" {}
}

parameter "Slack.PostDeploy.DeploymentLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Slack-formatted link to this run. The default links to the deployment, or to the runbook run."
    is_optional = true
    label = "Deployment link"

    value "#{if Octopus.RunbookRun.Id}<#{Octopus.Web.ServerUri}#{Octopus.Web.RunbookRunLink}|#{Octopus.RunbookRun.Name}>#{else}<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>#{/if}" {}
}

parameter "Parameters.CustomMessage" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Extra text added to the end of the Slack message. Leave blank for none."
    is_optional = true
    label = "Custom message"
}

step "slack-deployment-complete" {
    name = "Slack - Run Complete"

    action {
        action_type = "Octopus.SendSlackMessage"
        notes = "Works for deployments and runbook runs. Octopus.RunbookRun.Id only exists in a runbook run, so each part that differs switches on it. Runbook runs show the snapshot name, or the branch and commit for a runbook stored in Git."
        properties = {
            Octopus.Action.Slack.Blocks = <<-EOT
                [
                	{
                		"type": "section",
                		"text": {
                			"type": "mrkdwn",
                			"text": ":white_check_mark: #{Slack.PostDeploy.ProjectLink | JsonEscape} #{if Octopus.RunbookRun.Id}ran *#{Octopus.Runbook.Name | JsonEscape}* #{if Octopus.RunbookSnapshot.Name}(#{Octopus.RunbookSnapshot.Name | JsonEscape}) #{else}#{if Octopus.RunbookRun.Git.BranchName}(#{Octopus.RunbookRun.Git.BranchName | JsonEscape}@#{Octopus.RunbookRun.Git.CommitHash | Substring 7}) #{/if}#{/if}in#{else}#{Octopus.Release.Number | JsonEscape} to#{/if} #{Octopus.Environment.Name | JsonEscape}#{if Octopus.Deployment.Tenant.Name} for #{Octopus.Deployment.Tenant.Name | JsonEscape}#{/if}#{if Parameters.CustomMessage}\n\nCustom Message: #{Parameters.CustomMessage | JsonEscape}#{/if}"
                		}
                	},
                	{ "type": "divider" },
                	{
                		"type": "actions",
                		"elements": [
                			#{if Octopus.RunbookRun.Id}
                				#{if Octopus.RunbookSnapshot.Id}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": "View Snapshot", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.RunbookSnapshotLink | JsonEscape}",
                					"action_id": "actionId-snapshot"
                				},
                				#{/if}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": "View Runbook Run", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.RunbookRunLink | JsonEscape}",
                					"action_id": "actionId-runbook-run"
                				}
                			#{else}
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": "View Release", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.ReleaseLink | JsonEscape}",
                					"action_id": "actionId-release"
                				},
                				{
                					"type": "button",
                					"text": { "type": "plain_text", "text": "View Deployment", "emoji": true },
                					"url": "#{Octopus.Web.ServerUri | JsonEscape}#{Octopus.Web.DeploymentLink | JsonEscape}",
                					"action_id": "actionId-deployment"
                				}
                			#{/if}
                		]
                	}
                ]
                EOT
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                #{if Octopus.RunbookRun.Id}:white_check_mark: Runbook run complete for#{else}:white_check_mark: Deployment complete for#{/if}
                #{Slack.PostDeploy.ProjectLink} #{if Octopus.RunbookRun.Id}ran #{Octopus.Runbook.Name} in#{else}to#{/if} #{Octopus.Environment.Name}#{if Octopus.Deployment.Tenant.Name} for #{Octopus.Deployment.Tenant.Name}#{/if}

                #{if Slack.PostDeploy.ReleaseLink}#{Slack.PostDeploy.ReleaseLink} | #{/if}#{Slack.PostDeploy.DeploymentLink}

                #{if Parameters.CustomMessage}
                Custom: #{Parameters.CustomMessage}
                #{/if}
                EOT
            Octopus.Action.Slack.MessageFormat = "BlockKit"
            Octopus.Action.Slack.Title = "#{if Octopus.RunbookRun.Id}Runbook Complete#{else}Deployment Complete#{/if}"
        }
    }
}
