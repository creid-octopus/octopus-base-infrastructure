name = "Notifications - PostDeploy"
description = "Standardized postdeployment notification step(s)."

parameter "Slack.PostDeploy.ProjectLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}>" {}
}

parameter "Slack.PostDeploy.ReleaseLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>" {}
}

parameter "Slack.PostDeploy.DeplymentLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>" {}
}

step "slack-deployment-complete" {
    name = "Slack - Deployment Complete"

    action {
        action_type = "Octopus.SendSlackMessage"
        properties = {
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                :white_check_mark: Deployment complete for  
                 <#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}> to #{Octopus.Environment.Name} 
                
                <#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}> | <#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>
                EOT
        }
    }
}