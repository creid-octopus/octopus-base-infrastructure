name = "Notifications - PostDeploy"
description = "Standardized postdeployment notification step(s)."

parameter "Slack.PostDeploy.ProjectLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}>" {}
}

parameter "Slack.PostDeploy.ReleaseLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>" {}
}

parameter "Slack.PostDeploy.DeploymentLink" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""

    value "<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|#{Octopus.Deployment.Id}>" {}
}

parameter "Parameters.CustomMessage" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = ""
}

step "slack-deployment-complete" {
    name = "Slack - Deployment Complete"

    action {
        action_type = "Octopus.SendSlackMessage"
        properties = {
            Octopus.Action.Slack.Blocks = <<-EOT
                [
                	{
                		"type": "section",
                		"text": {
                			"type": "mrkdwn",
                			"text": ":white_check_mark: Deployment complete for #{Slack.PostDeploy.ProjectLink | JsonEscape} to #{Octopus.Environment.Name}\n#{if Parameters.CustomMessage | JsonEscape}Custom: #{Parameters.CustomMessage | JsonEscape}#{/if}"
                		}
                	},
                	{
                		"type": "divider"
                	},
                	{
                		"type": "actions",
                		"elements": [
                			{
                				"type": "button",
                				"text": {
                					"type": "plain_text",
                					"text": "View Release",
                					"emoji": true
                				},
                				"value": "#{Slack.PostDeploy.ReleaseLink | JsonEscape}",
                				"action_id": "actionId-release"
                			},
                			{
                				"type": "button",
                				"text": {
                					"type": "plain_text",
                					"text": "View Deployment",
                					"emoji": true
                				},
                				"value": "#{Slack.PostDeploy.DeploymentLink | JsonEscape}",
                				"action_id": "actionId-deployment"
                			}
                		]
                	}
                ]
                EOT
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = <<-EOT
                :white_check_mark: Deployment complete for  
                 #{Slack.PostDeploy.ProjectLink} to #{Octopus.Environment.Name} 
                
                #{Slack.PostDeploy.ReleaseLink} | #{Slack.PostDeploy.DeploymentLink}
                
                #{if Parameters.CustomMessage}
                Custom: #{Parameters.CustomMessage}
                #{/if}
                EOT
            Octopus.Action.Slack.MessageFormat = "BlockKit"
            Octopus.Action.Slack.Title = "Deployment Complete"
        }
    }
}