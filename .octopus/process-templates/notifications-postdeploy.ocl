name = "Notifications - PostDeploy"
description = "Standardized postdeployment notification step(s)."

step "slack-deployment-complete" {
    name = "Slack - Deployment Complete"

    action {
        action_type = "Octopus.SendSlackMessage"
        properties = {
            Octopus.Action.Slack.ChannelIds = "C0BNWQXANAG"
            Octopus.Action.Slack.ChannelNames = "new-releases"
            Octopus.Action.Slack.Message = "Deployment complete:\n <#{Octopus.Web.ServerUri}#{Octopus.Web.ProjectLink}|#{Octopus.Project.Name}> | <#{Octopus.Web.ServerUri}#{Octopus.Web.ReleaseLink}|#{Octopus.Release.Number}>\n<#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}|Follow deployment status here>"
        }
    }
}