name = "Postgres - Create Database If Not Exists"
description = "Creates a database on an existing Postgres server, owned by a login role. Safe to rerun: an existing database is left as it is. The owner login must already exist, for example from the Postgres - Create User If Not Exists template."

icon {
    color = "#336791"
    id = "database"
}

parameter "Postgres.TargetRole" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Target role of the Tentacle that runs psql against the Postgres server."
    label = "Target role"
}

parameter "Postgres.Server.Host" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Host the Tentacle uses to reach Postgres. On Docker Desktop, use host.docker.internal."
    label = "Server host"
}

parameter "Postgres.Server.Port" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Server port"
}

parameter "Postgres.Database.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Database to create, for example orders_dev."
    label = "Database name"
}

parameter "Postgres.Database.Owner" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Login role that owns the database. Must already exist on the server."
    label = "Database owner login"
}

parameter "Postgres.Admin" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = "Adminsitrator Postgres Account"

    value "postgres-local-admin" {}
}

step "create-postgres-database" {
    name = "Create Postgres database"
    properties = {
        Octopus.Action.TargetRoles = "#{Postgres.TargetRole}"
    }

    action {
        action_type = "Octopus.Script"
        notes = "Runs psql in a postgres:17 container through the Docker socket. Passwords go to psql on stdin, not on the command line."
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/usr/bin/env bash
                set -euo pipefail
                
                PG_HOST="$(get_octopusvariable "Postgres.Server.Host")"
                PG_PORT="$(get_octopusvariable "Postgres.Server.Port")"
                ADMIN_USER="$(get_octopusvariable "Postgres.Admin.Username")"
                ADMIN_PASSWORD="$(get_octopusvariable "Postgres.Admin.Password")"
                DB_NAME="$(get_octopusvariable "Postgres.Database.Name")"
                OWNER_NAME="$(get_octopusvariable "Postgres.Database.Owner")"
                
                # Escape single quotes for SQL string literals.
                sql_lit() { printf "%s" "${1//\'/\'\'}"; }
                
                export PGPASSWORD="$ADMIN_PASSWORD"
                
                echo "Creating database '$DB_NAME' owned by '$OWNER_NAME' on $PG_HOST:$PG_PORT if it does not exist"
                
                docker run --rm -i -e PGPASSWORD postgres:17 \
                  psql -X -h "$PG_HOST" -p "$PG_PORT" -U "$ADMIN_USER" -d postgres -v ON_ERROR_STOP=1 <<SQL
                \set db_name '$(sql_lit "$DB_NAME")'
                \set owner_name '$(sql_lit "$OWNER_NAME")'
                
                SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'owner_name')
                WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db_name') \gexec
                
                SELECT format('REVOKE CONNECT ON DATABASE %I FROM PUBLIC', :'db_name') \gexec
                SELECT format('GRANT CONNECT ON DATABASE %I TO %I', :'db_name', :'owner_name') \gexec
                SQL
                
                echo "Done: database '$DB_NAME' is ready for owner '$OWNER_NAME'"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}