name = "Postgres - Drop User If Exists"
description = "Drops a login role. Safe to rerun: a missing role is ignored. Drop the databases that the role owns first. The step fails if the role still owns objects. The step refuses to run in the protected environment."

icon {
    color = "#c0392b"
    id = "user"
}

parameter "Postgres.TargetRole" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Target role of the Tentacle that runs psql against the Postgres server."
    label = "Target role"
}

parameter "Postgres.Server.Host" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Host the Tentacle uses to reach Postgres. On Docker Desktop, use host.docker.internal."
    label = "Server host"
}

parameter "Postgres.Server.Port" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Server port"
}

parameter "Postgres.Login.Username" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Login role to drop."
    label = "Login username"
}

parameter "Postgres.Drop.ProtectedEnvironment" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    default_value = "Production"
    help_text = "Environment name where this step refuses to run. Leave blank to protect nothing."
    label = "Protected environment"
}

parameter "Postgres.Admin" {
    display_settings = {
        Octopus.ControlType = "UsernamePasswordAccount"
    }
    help_text = ""
    label = "Postgres Administrator Account"

    value "postgres-local-admin" {}
}

step "drop-postgres-user" {
    name = "Drop Postgres user"
    properties = {
        Octopus.Action.TargetRoles = "#{Postgres.TargetRole}"
    }

    action {
        action_type = "Octopus.Script"
        notes = "Runs psql in a postgres:17 container through the Docker socket."
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/usr/bin/env bash
                set -euo pipefail

                PG_HOST="$(get_octopusvariable "Postgres.Server.Host")"
                PG_PORT="$(get_octopusvariable "Postgres.Server.Port")"
                ADMIN_USER="$(get_octopusvariable "Postgres.Admin.Username")"
                ADMIN_PASSWORD="$(get_octopusvariable "Postgres.Admin.Password")"
                LOGIN_NAME="$(get_octopusvariable "Postgres.Login.Username")"
                PROTECTED="$(get_octopusvariable "Postgres.Drop.ProtectedEnvironment")"
                ENVIRONMENT_NAME="$(get_octopusvariable "Octopus.Environment.Name")"

                if [[ -n "$PROTECTED" && "${ENVIRONMENT_NAME,,}" == "${PROTECTED,,}" ]]; then
                  echo "Refusing to drop login '$LOGIN_NAME': '$ENVIRONMENT_NAME' is the protected environment."
                  exit 1
                fi

                # Escape single quotes for SQL string literals.
                sql_lit() { printf "%s" "${1//\'/\'\'}"; }

                export PGPASSWORD="$ADMIN_PASSWORD"

                echo "Dropping login '$LOGIN_NAME' on $PG_HOST:$PG_PORT if it exists"

                docker run --rm -i -e PGPASSWORD postgres:17 \
                  psql -X -h "$PG_HOST" -p "$PG_PORT" -U "$ADMIN_USER" -d postgres -v ON_ERROR_STOP=1 <<SQL
                \set login_name '$(sql_lit "$LOGIN_NAME")'

                SELECT format('DROP ROLE %I', :'login_name')
                WHERE EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'login_name') \gexec
                SQL

                echo "Done: login '$LOGIN_NAME' is gone"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}
