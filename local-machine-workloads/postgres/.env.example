# Copy to .env and set real values. Never commit .env.

# Local Postgres admin login
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# Octopus Tentacle registration
OCTOPUS_SERVER_URL=https://creid.octopus.app
OCTOPUS_API_KEY=API-REPLACE-ME
OCTOPUS_POLLING_ADDRESS=https://polling.creid.octopus.app
TENTACLE_NAME=local-postgres
TENTACLE_ENVIRONMENTS=Development,Test,Production
TENTACLE_ROLE=local-postgres
